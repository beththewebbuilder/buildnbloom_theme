{
	"apiVersion": 3,
	"name": "build-n-bloom-blocks/video-card",
	"version": "0.1.0",
	"title": "Video Card",
	"category": "buildnbloom",
	"icon": "format-video",
	"description": "A short muted video clip with a title, text and optional link. Plays on hover or loops automatically.",
	"parent": [ "build-n-bloom-blocks/item-grid" ],
	"supports": {
		"html": false,
		"reusable": false,
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"attributes": {
		"videoId": {
			"type": "number",
			"default": 0
		},
		"videoUrl": {
			"type": "string",
			"default": ""
		},
		"posterId": {
			"type": "number",
			"default": 0
		},
		"posterUrl": {
			"type": "string",
			"default": ""
		},
		"playback": {
			"type": "string",
			"default": "hover"
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"text": {
			"type": "string",
			"default": ""
		},
		"linkUrl": {
			"type": "string",
			"default": ""
		},
		"opensInNewTab": {
			"type": "boolean",
			"default": false
		}
	},
	"textdomain": "build-n-bloom-blocks",
	"viewScript": "file:../../../../build/video-card-view.js"
}
