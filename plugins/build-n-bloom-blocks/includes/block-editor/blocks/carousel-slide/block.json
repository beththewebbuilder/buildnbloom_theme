{
	"apiVersion": 3,
	"name": "build-n-bloom-blocks/carousel-slide",
	"version": "0.2.0",
	"title": "Slide Image",
	"category": "buildnbloom",
	"icon": "format-image",
	"description": "An image slide with an optional heading, text and link, and an optional separate image for mobile.",
	"parent": [ "build-n-bloom-blocks/carousel" ],
	"supports": {
		"html": false,
		"reusable": false,
		"color": {
			"text": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"attributes": {
		"imageId": {
			"type": "number",
			"default": 0
		},
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"imageAlt": {
			"type": "string",
			"default": ""
		},
		"focalPoint": {
			"type": "object"
		},
		"useMobileImage": {
			"type": "boolean",
			"default": false
		},
		"mobileImageId": {
			"type": "number",
			"default": 0
		},
		"mobileImageUrl": {
			"type": "string",
			"default": ""
		},
		"mobileFocalPoint": {
			"type": "object"
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"caption": {
			"type": "string",
			"default": ""
		},
		"captionPosition": {
			"type": "string",
			"default": "below"
		},
		"imageFit": {
			"type": "string",
			"default": ""
		},
		"hoverEffect": {
			"type": "string",
			"default": "none"
		},
		"linkUrl": {
			"type": "string",
			"default": ""
		},
		"opensInNewTab": {
			"type": "boolean",
			"default": false
		}
	},
	"textdomain": "build-n-bloom-blocks"
}
