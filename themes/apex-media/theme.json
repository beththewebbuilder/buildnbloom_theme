{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "name": "Background", "color": "#ffffff" },
				{ "slug": "contrast", "name": "Text", "color": "#000000" },
				{ "slug": "primary", "name": "Primary", "color": "#000000" },
				{ "slug": "on-primary", "name": "Text on primary", "color": "#ffffff" },
				{ "slug": "secondary", "name": "Apex red", "color": "#b70000" },
				{ "slug": "on-secondary", "name": "Text on Apex red", "color": "#ffffff" },
				{ "slug": "muted", "name": "Muted background", "color": "#f2f2f2" },
				{ "slug": "border", "name": "Border", "color": "#cccccc" },
				{ "slug": "header", "name": "Header & footer", "color": "#000000" },
				{ "slug": "on-header", "name": "Text on header & footer", "color": "#ffffff" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "heading",
					"name": "Qualy",
					"fontFamily": "Qualy, \"Segoe UI\", system-ui, sans-serif"
				}
			]
		}
	},
	"styles": {
		"elements": {
			"h1": { "typography": { "fontSize": "clamp(2rem, 4vw, 2.5rem)" } },
			"h2": { "typography": { "fontSize": "2rem" } },
			"h3": { "typography": { "fontSize": "1.5rem" } },
			"h4": { "typography": { "fontSize": "1.25rem" } },
			"heading": {
				"typography": { "fontWeight": "400" }
			},
			"button": {
				"color": {
					"background": "var:preset|color|base",
					"text": "var:preset|color|contrast"
				},
				"border": {
					"color": "var:preset|color|contrast"
				},
				"typography": {
					"fontWeight": "400"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					},
					"border": { "color": "var:preset|color|contrast" }
				}
			}
		}
	}
}
