{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "name": "Paper", "color": "#f5f8f5" },
				{ "slug": "contrast", "name": "Ink", "color": "#0c2c1e" },
				{ "slug": "primary", "name": "Forest green", "color": "#14452f" },
				{ "slug": "on-primary", "name": "Text on green", "color": "#ffffff" },
				{ "slug": "secondary", "name": "Green hover", "color": "#1e5a3e" },
				{ "slug": "on-secondary", "name": "Text on green hover", "color": "#ffffff" },
				{ "slug": "muted", "name": "Paper dark", "color": "#e8f0eb" },
				{ "slug": "border", "name": "Border", "color": "#cfdcd3" },
				{ "slug": "header", "name": "Hero green", "color": "#14452f" },
				{ "slug": "on-header", "name": "Text on hero green", "color": "#ffffff" },
				{ "slug": "surface", "name": "White", "color": "#ffffff" },
				{ "slug": "steel", "name": "Dark section green", "color": "#14452f" },
				{ "slug": "primary-on-dark", "name": "Pale green (on dark backgrounds)", "color": "#a9cdb6" },
				{ "slug": "accent-text", "name": "Green text (small text on light backgrounds)", "color": "#14452f" },
				{ "slug": "subtle-text", "name": "Subtle text", "color": "#4a5f54" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Barlow",
					"fontFamily": "Barlow, Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Barlow", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/barlow-400.woff2" ] },
						{ "fontFamily": "Barlow", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/barlow-500.woff2" ] },
						{ "fontFamily": "Barlow", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/barlow-600.woff2" ] }
					]
				},
				{
					"slug": "heading",
					"name": "Barlow Condensed",
					"fontFamily": "\"Barlow Condensed\", \"Arial Narrow\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Barlow Condensed", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/barlow-condensed-500.woff2" ] },
						{ "fontFamily": "Barlow Condensed", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/barlow-condensed-600.woff2" ] },
						{ "fontFamily": "Barlow Condensed", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/barlow-condensed-700.woff2" ] }
					]
				},
				{
					"slug": "mono",
					"name": "IBM Plex Mono",
					"fontFamily": "\"IBM Plex Mono\", Consolas, monospace",
					"fontFace": [
						{ "fontFamily": "IBM Plex Mono", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ibm-plex-mono-400.woff2" ] },
						{ "fontFamily": "IBM Plex Mono", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ibm-plex-mono-500.woff2" ] }
					]
				}
			]
		},
		"custom": {
			"button": {
				"radius": "0"
			}
		}
	},
	"styles": {
		"typography": {
			"fontSize": "1.0625rem",
			"lineHeight": "1.55"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.02",
					"letterSpacing": "0.005em",
					"textTransform": "uppercase"
				}
			},
			"h1": { "typography": { "fontSize": "clamp(3.375rem, 7.6vw, 6.5rem)" } },
			"h2": { "typography": { "fontSize": "clamp(2.25rem, 5vw, 3.625rem)" } },
			"h3": { "typography": { "fontSize": "1.625rem" } },
			"h4": { "typography": { "fontSize": "1.375rem" } },
			"link": {
				"color": { "text": "var:preset|color|accent-text" },
				":hover": { "color": { "text": "var:preset|color|contrast" } }
			},
			"button": {
				"typography": {
					"fontSize": "1.1875rem",
					"fontWeight": "700",
					"letterSpacing": "0.04em",
					"lineHeight": "1",
					"textTransform": "uppercase"
				},
				"spacing": {
					"padding": { "top": "0.8em", "right": "1.15em", "bottom": "0.8em", "left": "1.15em" }
				},
				":focus-visible": {
					"outline": { "color": "var:preset|color|primary", "offset": "2px", "style": "solid", "width": "3px" }
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"color": { "background": "transparent", "text": "currentColor" },
						"border": { "color": "currentColor", "width": "2px", "style": "solid" }
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "0.9375rem",
					"fontWeight": "500"
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": { "text": "var:preset|color|contrast" },
						":hover": { "color": { "text": "var:preset|color|accent-text" } }
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "1.5625rem",
					"letterSpacing": "0.04em",
					"lineHeight": "1",
					"textTransform": "uppercase"
				}
			}
		}
	}
}
