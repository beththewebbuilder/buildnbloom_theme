{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Background", "color": "#ffffff" },
				{ "slug": "contrast", "name": "Text", "color": "#1a1a1a" },
				{ "slug": "primary", "name": "Primary", "color": "#2b4c7e" },
				{ "slug": "on-primary", "name": "Text on primary", "color": "#ffffff" },
				{ "slug": "secondary", "name": "Secondary", "color": "#1a1a1a" },
				{ "slug": "on-secondary", "name": "Text on secondary", "color": "#ffffff" },
				{ "slug": "muted", "name": "Muted background", "color": "#f2f2f2" },
				{ "slug": "border", "name": "Border", "color": "#d9d9d9" },
				{ "slug": "header", "name": "Header & footer", "color": "#1a1a1a" },
				{ "slug": "on-header", "name": "Text on header & footer", "color": "#ffffff" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1400px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "2X-Small", "size": "0.5rem" },
				{ "slug": "30", "name": "X-Small", "size": "1rem" },
				{ "slug": "40", "name": "Small", "size": "clamp(1rem, 3vw, 1.5rem)" },
				{ "slug": "50", "name": "Medium", "size": "clamp(1.5rem, 5vw, 3rem)" },
				{ "slug": "60", "name": "Large", "size": "clamp(2rem, 7vw, 5rem)" },
				{ "slug": "70", "name": "X-Large", "size": "clamp(3rem, 10vw, 8rem)" }
			],
			"units": [ "px", "em", "rem", "%", "vh", "vw" ]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "heading",
					"name": "Headings",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "slug": "large", "name": "Large", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "2X large", "size": "2.75rem", "fluid": { "min": "2rem", "max": "2.75rem" } },
				{ "slug": "huge", "name": "Huge", "size": "4.5rem", "fluid": { "min": "2.75rem", "max": "4.5rem" } }
			]
		},
		"custom": {
			"button": {
				"radius": "4px"
			},
			"header": {
				"position": "sticky"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|huge" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"h5": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"h6": { "typography": { "fontSize": "var:preset|font-size|small" } },
			"link": {
				"color": { "text": "var:preset|color|primary" },
				":hover": { "color": { "text": "var:preset|color|secondary" } }
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|on-primary"
				},
				"border": {
					"width": "2px",
					"style": "solid",
					"color": "var:preset|color|primary",
					"radius": "var(--wp--custom--button--radius)"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontSize": "1rem",
					"fontWeight": "600",
					"lineHeight": "1.2"
				},
				"spacing": {
					"padding": { "top": "0.75em", "right": "1.5em", "bottom": "0.75em", "left": "1.5em" }
				},
				":hover": {
					"color": {
						"background": "var:preset|color|secondary",
						"text": "var:preset|color|on-secondary"
					},
					"border": { "color": "var:preset|color|secondary" }
				},
				":focus-visible": {
					"outline": { "color": "var:preset|color|contrast", "offset": "3px", "style": "solid", "width": "2px" }
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "700"
				},
				"elements": {
					"link": {
						"color": { "text": "currentColor" },
						"typography": { "textDecoration": "none" }
					}
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-no-title", "title": "Page without title (full width)", "postTypes": [ "page" ] }
	]
}
